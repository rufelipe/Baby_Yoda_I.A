# Copie este arquivo para .env no seu computador e preencha os valores.
# Nunca envie o arquivo .env para o GitHub.

GEMINI_API_KEY=cole_sua_chave_da_gemini_aqui
SITE_PASSWORD=crie_uma_senha_de_acesso_forte
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.1-pro-preview
GEMINI_MODEL_RETRIES=2
GEMINI_REQUEST_TIMEOUT_SECONDS=45
GEMINI_FALLBACK_BUDGET_SECONDS=240
